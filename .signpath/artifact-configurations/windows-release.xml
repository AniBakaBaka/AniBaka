    <zip-file path="baka-*-windows-x64.zip">
      <pe-file
        path="baka.exe"
        product-name="Baka动漫"
        product-version="${version}">
        <authenticode-sign />
      </pe-file>
    </zip-file>
  </zip-file>
</artifact-configuration>
