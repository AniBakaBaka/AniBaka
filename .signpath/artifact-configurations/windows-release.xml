  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file
      path="baka-*-windows-x64.exe"
      product-name="Baka动漫"
      product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <msix-file path="baka-*-windows-x64.msix">
      <authenticode-sign />
