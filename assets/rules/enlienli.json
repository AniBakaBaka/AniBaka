{
  "format": "anx-rule/2",
  "id": "enlienli",
  "name": "OmoFun Enlienli",
  "baseUrl": "https://enlienli.link",
  "iconUrl": "https://enlienli.link/template/mxpro/mxtheme/images/favicon.png",
  "description": "Omofun是一个专注于动漫资源分享和在线播放的平台，涵盖日本新番、经典动漫作品以及一些国产动画和剧场版电影。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://enlienli.link/"
  },
  "useWebview": true,
  "search": [
    {
      "op": "fetch",
      "url": "https://enlienli.link/vod/search.html?wd={keyword}"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "jsonSeries",
            "listPath": "list",
            "idKey": "id",
            "nameKey": "name",
            "imageKey": "pic",
            "urlKey": "url"
          }
        ],
        [
          {
            "op": "searchList",
            "selectors": [
              ".module-card-item, a.module-card-item[href], .module-poster-item, .module-search-item, a[href*=\"/vod/detail/\"], a[href*=\"/voddetail/\"], a[href*=\"/detail/\"]"
            ]
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "listSelectors": [
        ".module-play-list, .module-player-list, .module-player-list.tab-list, .stui-content__playlist, .anthology-list-box, .playlist, .play-list, .play_list, .episode-list, #playlist, .episodes"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "playerAaaa",
            "var": "player_aaaa",
            "key": "url"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "video"
          }
        ]
      ]
    }
  ]
}
