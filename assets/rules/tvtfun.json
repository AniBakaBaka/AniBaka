{
  "format": "anx-rule/2",
  "id": "tvtfun",
  "name": "TvTFun",
  "baseUrl": "https://www.tvtfun.net",
  "iconUrl": "https://www.tvtfun.net/favicon-32x32.png",
  "description": "TvTFun 动漫视频源。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Referer": "https://tvtfun.net/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/api/videos/search?q={keyword}"
    },
    {
      "op": "jsonSeries",
      "listPath": "data.videos",
      "idKey": "id",
      "nameKey": "name",
      "imageKey": "pic",
      "descKey": "remarks",
      "detailUrlTemplate": "/api/videos/{id}"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "jsonEpisodes",
      "sourcesPath": "data.playSources",
      "episodesKey": "episodes",
      "sourceNameKey": "name",
      "episodeNameKey": "name",
      "episodeIdTemplate": "{id:raw}"
    }
  ],
  "play": [
    {
      "op": "fetch",
      "url": "/api/videos/resolve-play-url?episodeId={episodeId}"
    },
    {
      "op": "setMediaHeaders",
      "jsonPath": "data.headers"
    },
    {
      "op": "json",
      "path": "data.url"
    }
  ]
}
