{
  "format": "anx-rule/2",
  "id": "tvtfun",
  "name": "TvTFun",
  "baseUrl": "https://www.tvtfun.net",
  "iconUrl": "https://www.tvtfun.net/favicon-32x32.png",
  "description": "TvTFun 动漫视频源。",
  "directConnection": true,
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Referer": "https://www.tvtfun.net/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/api/videos/search?q={keyword}"
    },
    {
      "op": "jsonSeries",
      "listPath": "data.videos",
      "idKey": "id",
      "nameKey": "name",
      "imageKey": "pic",
      "descKey": "remarks",
      "detailUrlTemplate": "/api/videos/{id}"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "setVar",
      "name": "tvtDetailJson",
      "value": "{url:raw}"
    },
    {
      "op": "json",
      "path": "data.slug"
    },
    {
      "op": "setVar",
      "name": "tvtVideoSlug",
      "value": "{url:raw}"
    },
    {
      "op": "template",
      "value": "{tvtDetailJson:raw}"
    },
    {
      "op": "jsonEpisodes",
      "sourcesPath": "data.playSources",
      "episodesKey": "episodes",
      "sourceNameKey": "name",
      "episodeNameKey": "name",
      "episodeIdTemplate": "{id:raw}|{tvtVideoSlug:raw}|{source_index:raw}|{sort:raw}"
    }
  ],
  "play": [
    {
      "op": "setVar",
      "name": "tvtPackedEpisode",
      "value": "{episodeId:raw}"
    },
    {
      "op": "regex",
      "pattern": "^([^|]+)",
      "group": 1
    },
    {
      "op": "setVar",
      "name": "tvtEpisodeId",
      "value": "{url:raw}"
    },
    {
      "op": "template",
      "value": "{tvtPackedEpisode:raw}"
    },
    {
      "op": "regex",
      "pattern": "^[^|]+\\|([^|]+)",
      "group": 1
    },
    {
      "op": "setVar",
      "name": "tvtVideoSlug",
      "value": "{url:raw}"
    },
    {
      "op": "template",
      "value": "{tvtPackedEpisode:raw}"
    },
    {
      "op": "regex",
      "pattern": "^[^|]+\\|[^|]+\\|([^|]+)",
      "group": 1
    },
    {
      "op": "setVar",
      "name": "tvtSourceIndex",
      "value": "{url:raw}"
    },
    {
      "op": "template",
      "value": "{tvtPackedEpisode:raw}"
    },
    {
      "op": "regex",
      "pattern": "^[^|]+\\|[^|]+\\|[^|]+\\|([^|]+)",
      "group": 1
    },
    {
      "op": "setVar",
      "name": "tvtEpisodeIndex",
      "value": "{url:raw}"
    },
    {
      "op": "fetch",
      "url": "/video/{tvtVideoSlug}/play?source={tvtSourceIndex}&episode={tvtEpisodeIndex}",
      "cookieSession": true,
      "headers": {
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Referer": "https://www.tvtfun.net/video/{tvtVideoSlug}"
      }
    },
    {
      "op": "fetch",
      "url": "/api/videos/resolve-play-url?episodeId={tvtEpisodeId}",
      "delayMs": 600,
      "headers": {
        "Accept": "application/json",
        "Referer": "https://www.tvtfun.net/video/{tvtVideoSlug}/play?source={tvtSourceIndex}&episode={tvtEpisodeIndex}",
        "X-Play-Ctx": "eyJmIjozMDAsInYiOjEsInciOjEyODAsImhndCI6NzIwLCJwIjoxfQ=="
      }
    },
    {
      "op": "setMediaHeaders",
      "headers": {
        "Referer": ""
      },
      "jsonPath": "data.headers"
    },
    {
      "op": "json",
      "path": "data.url"
    }
  ],
  "home": [
    {
      "op": "fetch",
      "url": "/"
    },
    {
      "op": "searchList",
      "selectors": [
        "a.legacy-video-card"
      ],
      "detailPattern": "/anime/"
    }
  ]
}