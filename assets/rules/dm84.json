{
  "format": "anx-rule/2",
  "id": "dm84",
  "name": "DM84",
  "baseUrl": "https://dmbus.cc",
  "iconUrl": "https://dmbus.cc/favicon.ico",
  "description": "DM84 动漫视频源，源网站 dm84.net（当前入口 dmbus.cc）。",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Accept": "*/*",
    "Referer": "https://dmbus.cc/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "/s----------.html?wd={keyword}"
    },
    {
      "op": "searchList",
      "selectors": [
        ".search-list .item",
        ".video-list li",
        ".drama-module li",
        ".module-items .module-item",
        ".module-search-item",
        ".stui-vodlist__box",
        ".list-item",
        "ul.items li",
        "div.item",
        "li.video-item"
      ],
      "detailPattern": "/v/"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "tabSelectors": [
        "ul.tab_control.play_from li",
        "ul.tab_control li",
        ".play_from li",
        "#tab li",
        ".play_source_tab li"
      ],
      "listSelectors": [
        "ul.play_list",
        ".play_list",
        ".player_list",
        ".playlist",
        ".episode-list"
      ]
    }
  ],
  "play": [
    {
      "op": "follow"
    },
    {
      "op": "select",
      "css": "iframe[src*=\"hhjx.hhplayer.com\"]",
      "attr": "src"
    },
    {
      "op": "hhPlayer",
      "apiUrl": "https://hhjx.hhplayer.com/api.php",
      "urlQueryParam": "url",
      "timestampPattern": "var\\s+t\\s*=\\s*[\"'](\\d+)[\"']",
      "timestampGroup": 1,
      "encodedKeyPattern": "var\\s+key\\s*=\\s*OKOK\\([\"']([^\"']+)[\"']\\)",
      "encodedKeyGroup": 1,
      "caseSensitive": true,
      "dotAll": false,
      "urlField": "url",
      "timestampField": "t",
      "keyField": "key",
      "fixedBody": {
        "act": "0",
        "play": "1"
      },
      "contentType": "form",
      "headers": {
        "Accept": "application/json, text/plain, */*",
        "Referer": "https://hhjx.hhplayer.com/",
        "Origin": "https://hhjx.hhplayer.com",
        "X-Requested-With": "XMLHttpRequest"
      },
      "codePath": "code",
      "successCode": "200",
      "urlPath": "url",
      "charMap": {
        "0Oo0o0Oo": "a",
        "1O0bO001": "b",
        "1OoCcO1": "c",
        "3O0dO0O3": "d",
