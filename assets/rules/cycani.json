{
  "format": "anx-rule/2",
  "id": "cycani",
  "name": "Cycani 次元城",
  "baseUrl": "https://www.cycani.org",
  "iconUrl": "https://www.cycity.pro/site.webp",
  "description": "Cycani 次元城动画视频源",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Accept": "application/json",
    "X-App-Name": "cyc_web",
    "X-Time-Zone": "Asia/Shanghai",
    "X-App-Version": "cycweb",
    "Referer": "https://www.cycani.org/"
  },
  "useWebview": false,
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "/api/videos/search?q={keyword}&page=1&page_size=20"
          },
          {
            "op": "jsonSeries",
            "listPath": "data.list",
            "idKey": "video_id",
            "nameKey": "title",
            "imageKey": "cover_url",
            "detailUrlTemplate": "/anime/{id}",
            "keywordMatch": false
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "/api/videos/search?q={keyword}&page=1&page_size=20",
            "readyContains": [
              "\"list\""
            ],
            "timeoutMs": 30000,
            "settleMs": 0
          },
          {
            "op": "select",
            "css": "body",
            "attr": "text"
          },
          {
            "op": "jsonSeries",
            "listPath": "data.list",
            "idKey": "video_id",
            "nameKey": "title",
            "imageKey": "cover_url",
            "detailUrlTemplate": "/anime/{id}",
            "keywordMatch": false
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "regex",
            "pattern": "(?:/anime/|/bangumi/)?(\\d+)",
            "group": 1
          },
          {
            "op": "fetch",
            "url": "/api/videos/{url:raw}/sections?player_code=cychub&page=1&page_size=100"
          },
          {
            "op": "jsonEpisodes",
            "sourceName": "Cycani 次元城",
            "episodesPath": "data.list",
            "idKey": "id",
            "nameKey": "title",
            "episodeIdTemplate": "/api/sections/{id}/play-url"
          }
        ],
        [
          {
            "op": "regex",
            "pattern": "(?:/anime/|/bangumi/)?(\\d+)",
            "group": 1
          },
          {
            "op": "sniff",
            "goal": "html",
            "url": "/api/videos/{url:raw}/sections?player_code=cychub&page=1&page_size=100",
            "readyContains": [
              "list"
            ],
            "timeoutMs": 30000
          },
          {
            "op": "select",
            "css": "body",
            "attr": "text"
          },
          {
            "op": "jsonEpisodes",
            "sourceName": "Cycani 次元城",
            "episodesPath": "data.list",
            "idKey": "id",
            "nameKey": "title",
            "episodeIdTemplate": "/api/sections/{id}/play-url"
          }
        ]
      ]
    }
  ],
  "play": [
    {
      "op": "setMediaHeaders",
      "headers": {
        "Referer": "https://www.cycani.org/",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36"
      }
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "regex",
            "pattern": "(?:/api/sections/)?(\\d+)",
            "group": 1
          },
          {
            "op": "fetch",
            "url": "/api/sections/{url:raw}/play-url"
          },
          {
            "op": "json",
            "path": "data.url|data"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "regex",
            "pattern": "(?:/api/sections/)?(\\d+)",
            "group": 1
          },
          {
            "op": "sniff",
            "goal": "html",
            "url": "/api/sections/{url:raw}/play-url",
            "readyContains": [
              "url"
            ],
            "timeoutMs": 15000
          },
          {
            "op": "select",
            "css": "body",
            "attr": "text"
          },
          {
            "op": "json",
            "path": "data.url|data"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ]
      ]
    }
  ]
}
