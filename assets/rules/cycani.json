{
  "format": "anx-rule/2",
  "id": "cycani",
  "name": "Cycani 次元城",
  "baseUrl": "https://www.cycani.org",
  "iconUrl": "https://www.cycity.pro/site.webp",
  "description": "Cycani 次元城动画视频源",
  "headers": {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36",
    "Accept": "*/*"
  },
  "search": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "maccmsSuggest",
            "verify": true,
            "headers": {
              "Accept": "application/json, text/javascript, */*; q=0.01",
              "Referer": "https://www.cycani.org/"
            },
            "detailUrlTemplate": "/bangumi/{id}.html"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "url": "/index.php/ajax/suggest?mid=1&wd={keyword}&limit=20",
            "readyContains": [
              "\"list\""
            ],
            "rejectContains": [
              "altcha-widget",
              "aegis_altcha"
            ],
            "timeoutMs": 30000,
            "settleMs": 0
          },
          {
            "op": "select",
            "css": "body",
            "attr": "text"
          },
          {
            "op": "jsonSeries",
            "listPath": "list",
            "detailUrlTemplate": "/bangumi/{id}.html"
          }
        ]
      ]
    }
  ],
  "detail": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "regex",
            "pattern": "/bangumi/(\\d+)",
            "group": 1
          },
          {
            "op": "template",
            "value": "/api.php/provide/vod/?ac=detail&ids={url:raw}"
          },
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.cycani.org/"
            }
          },
          {
            "op": "maccmsVerify"
          },
          {
            "op": "maccmsApiEpisodes",
            "listPath": "list"
          }
        ],
        [
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.cycani.org/"
            }
          },
          {
            "op": "maccmsVerify"
          },
          {
            "op": "episodes",
            "listSelectors": [
              ".anthology-list .anthology-list-box",
              ".anthology-list-box",
              ".anthology-list-play"
            ],
            "tabSelectors": [
              ".anthology-tab .swiper-slide",
              ".anthology-tab a",
              ".module-tab-item",
              ".tab-item"
            ]
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "readyContains": [
              "anthology-list"
            ],
            "rejectContains": [
              "altcha-widget",
              "aegis_altcha"
            ],
            "timeoutMs": 60000,
            "settleMs": 0
          },
          {
            "op": "episodes",
            "listSelectors": [
              ".anthology-list .anthology-list-box",
              ".anthology-list-box",
              ".anthology-list-play"
            ],
            "tabSelectors": [
              ".anthology-tab .swiper-slide",
              ".anthology-tab a",
              ".module-tab-item",
              ".tab-item"
            ]
          }
        ]
      ]
    }
  ],
  "useWebview": true,
  "play": [
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.cycani.org/"
            }
          },
          {
            "op": "maccmsVerify"
          }
        ],
        [
          {
            "op": "sniff",
            "goal": "html",
            "readyContains": [
              "player_aaaa"
            ],
            "rejectContains": [
              "altcha-widget",
              "aegis_altcha"
            ],
            "timeoutMs": 60000,
            "settleMs": 0
          }
        ]
      ]
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "playerAaaa"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "playerAaaa"
          },
          {
            "op": "template",
            "value": "https://player.cycanime.com/?url={url:raw}"
          },
          {
            "op": "follow",
            "headers": {
              "Referer": "https://www.cycani.org/"
            }
          },
          {
            "op": "playerDecrypt",
            "salt": "YLwJVbXw77pk2eOrAnFdBo2c3mWkLtodMni2wk81GCnP94ZltW"
          }
        ],
        [
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "playerAaaa"
          },
          {
            "op": "template",
            "value": "https://player.cycanime.com/?url={url:raw}"
          },
          {
            "op": "sniff",
            "goal": "video"
          }
        ]
      ]
    }
  ]
}
