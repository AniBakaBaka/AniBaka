{
  "format": "anx-rule/2",
  "id": "xifanacg",
  "name": "Xifanacg Next",
  "baseUrl": "https://next.xifanacg.com",
  "iconUrl": "https://next.xifanacg.com/favicon.ico",
  "description": "稀饭动漫 Next 视频源，源网址 https://next.xifanacg.com/",
  "headers": {
    "Referer": "https://next.xifanacg.com/"
  },
  "search": [
    {
      "op": "fetch",
      "url": "https://rzmsnqblptbceicadbyd.supabase.co/rest/v1/rpc/search_animes",
      "method": "POST",
      "contentType": "application/json",
      "headers": {
        "Accept": "application/json",
        "apikey": "sb_publishable_aCb7uwyLN6H-sMjze4dRGA_2MDuROLF",
        "Authorization": "Bearer sb_publishable_aCb7uwyLN6H-sMjze4dRGA_2MDuROLF",
        "Origin": "https://next.xifanacg.com"
      },
      "body": {
        "search_term": "{keyword:raw}"
      }
    },
    {
      "op": "jsonSeries",
      "idKey": "id",
      "nameKey": "title",
      "imageKey": "cover_url",
      "descKey": "description",
      "detailUrlTemplate": "/anime/{id}"
    }
  ],
  "detail": [
    {
      "op": "follow"
    },
    {
      "op": "episodes",
      "roadsXPath": "//section",
      "itemsXPath": ".//a[contains(@href, \"/play/\")]"
    }
  ],
  "play": [
    {
      "op": "regex",
      "pattern": "/play/(\\d+)",
      "group": 1
    },
    {
      "op": "setVar",
      "name": "xifanEpisodeId",
      "value": "{url:raw}"
    },
    {
      "op": "first",
      "branches": [
        [
          {
            "op": "fetch",
            "url": "https://rzmsnqblptbceicadbyd.supabase.co/functions/v1/issue-web-playback",
            "method": "POST",
            "contentType": "application/json",
            "headers": {
              "Accept": "application/json",
              "apikey": "sb_publishable_aCb7uwyLN6H-sMjze4dRGA_2MDuROLF",
              "Authorization": "Bearer sb_publishable_aCb7uwyLN6H-sMjze4dRGA_2MDuROLF",
              "Origin": "https://next.xifanacg.com"
            },
            "body": "{\"action\":\"hls\",\"episode_id\":{xifanEpisodeId:raw}}"
          },
          {
            "op": "json",
            "path": "url"
          },
          {
            "op": "videoUrl"
          }
        ],
        [
          {
            "op": "fetch",
            "url": "https://rzmsnqblptbceicadbyd.supabase.co/functions/v1/issue-web-playback",
            "method": "POST",
            "contentType": "application/json",
            "headers": {
              "Accept": "application/json",
              "apikey": "sb_publishable_aCb7uwyLN6H-sMjze4dRGA_2MDuROLF",
              "Authorization": "Bearer sb_publishable_aCb7uwyLN6H-sMjze4dRGA_2MDuROLF",
              "Origin": "https://next.xifanacg.com"
            },
            "body": "{\"action\":\"fallback\",\"episode_id\":{xifanEpisodeId:raw}}"
          },
          {
            "op": "json",
            "path": "url"
          },
          {
            "op": "videoUrl"
          }
        ]
      ]
    }
  ]
}
